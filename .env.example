# Copy this file to .env and fill in. Never commit .env.

# Sign-in, option 1: a Gemini API key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=your-gemini-api-key-here

# Sign-in, option 2: Vertex AI (leave the key above empty and set these three)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Models, one per job. If one is not available to your account, that job falls back to AGENT_MODEL.
AGENT_MODEL=gemini-3.8-flash            # reasoning, coaching, part check, finding parts in photos
SECOND_CHECK_MODEL=gemini-4-argon       # independent second check of each diagnosis
CARD_MODEL=gemini-3.5-flash-lite        # reading handwritten job cards
VOICE_MODEL=gemini-3.5-transcribe       # spoken notes to text
# VISION_MODEL=                         # finding parts in photos, if you want a different model

# Equipment profile file in faultlens/knowledge/
EQUIPMENT_PROFILE=split_ac

# 1 = offline mode, no API calls, canned answers (for UI work only)
FAULTLENS_MOCK=0
